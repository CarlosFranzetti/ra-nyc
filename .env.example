# Everything below is OPTIONAL. With none of it set, the app works: artist links
# resolve live on each request and are cached at Vercel's edge.

# Neon Postgres connection string (pooled endpoint).
# Enables durable caching of resolved artist links, and is what makes
# hand-corrected DJ links possible. See DATABASE.md.
# Apply migrations/0001_artist_links.sql before first use.
DATABASE_URL=

# Discogs personal access token.
# Their search endpoint requires auth, so without this the Discogs link is a
# search URL rather than the artist's exact page.
DISCOGS_TOKEN=

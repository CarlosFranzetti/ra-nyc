{
  "name": "ra-nyc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.api.json",
    "test:e2e": "node tests/player.e2e.mjs",
    "test:search": "node tests/search.e2e.mjs",
    "test:layout": "node tests/layout.e2e.mjs",
    "test:offline": "npm run build && node tests/offline.e2e.mjs",
    "test:preview": "node tests/preview.e2e.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e && npm run test:search && npm run test:layout && npm run test:preview && npm run test:donate && npm run test:settings && npm run test:offline",
    "test:donate": "node tests/donate.e2e.mjs",
    "test:settings": "node tests/settings.e2e.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.24",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  }
}

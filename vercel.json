{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "_comment_functions": "Listed one by one rather than as an api/*.ts glob. Vercel rejects a pattern whose functions another pattern has already claimed — adding api/backfill.ts alongside api/*.ts failed the deploy outright with 'doesn't match any Serverless Functions'. Backfill needs 60s because it fills the search index 60 days at a time; everything else is a request a person is waiting on and should never take 15.",
  "functions": {
    "api/artist.ts": {
      "maxDuration": 15
    },
    "api/backfill.ts": {
      "maxDuration": 60
    },
    "api/events.ts": {
      "maxDuration": 15
    },
    "api/health.ts": {
      "maxDuration": 15
    },
    "api/image.ts": {
      "maxDuration": 15
    },
    "api/search.ts": {
      "maxDuration": 15
    },
    "api/venue.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/backfill",
      "schedule": "0 9 * * *"
    }
  ]
}
